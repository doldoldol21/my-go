{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "go run 지금 파일",
			"detail": "열려 있는 파일의 폴더를 go run 한다",
			"type": "shell",
			"command": "go run ./${relativeFileDirname}",
			"options": { "cwd": "${workspaceFolder}" },
			"group": { "kind": "build", "isDefault": true },
			"presentation": { "clear": true, "reveal": "always", "focus": false },
			"problemMatcher": ["$go"]
		}
	]
}
